# Production Environment Configuration for Give-Share-Gain

## ⚠️ IMPORTANTE: Esta archivo contiene EJEMPLOS SOLAMENTE
# NUNCA commits secretos reales a Git
# Usar Railway Environment Variables o .env.production.local (en .gitignore)

# ==================== DATABASE ====================

# MongoDB URIs - Obtener de MongoDB Atlas
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-password-here

# Para cada servicio (reemplazar con URLs reales de MongoDB Atlas)
MONGO_URI_USERS=mongodb+srv://admin:PASSWORD@production.m7kj3.mongodb.net/users?retryWrites=true&w=majority
MONGO_URI_PRODUCTS=mongodb+srv://admin:PASSWORD@production.m7kj3.mongodb.net/products?retryWrites=true&w=majority
MONGO_URI_CART=mongodb+srv://admin:PASSWORD@production.m7kj3.mongodb.net/cart?retryWrites=true&w=majority
MONGO_URI_ORDER=mongodb+srv://admin:PASSWORD@production.m7kj3.mongodb.net/orders?retryWrites=true&w=majority
MONGO_URI_PAYMENT=mongodb+srv://admin:PASSWORD@production.m7kj3.mongodb.net/payments?retryWrites=true&w=majority

# ==================== AUTHENTICATION ====================

# JWT Secret - Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_32_CHARS_MIN
JWT_EXPIRY=7d

# ==================== MESSAGING SERVICE ====================

# URL del servicio de mensajería (messaging-service en Railway)
VITE_MESSAGING_API_BASE_URL=https://messaging-service-production-1fb5.up.railway.app

# ==================== API CONFIGURATION ====================

# Node environment
NODE_ENV=production

# Ports por servicio
USER_SERVICE_PORT=5000
PRODUCT_SERVICE_PORT=5001
CART_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5003
PAYMENT_SERVICE_PORT=5004
NOTIFICATION_SERVICE_PORT=5005

# API Gateway
FRONTEND_PORT=8080
API_GATEWAY_PORT=80

# URLs para inter-service communication (Cambiar según deployment)
USER_SERVICE_URI=http://user-service:5000
PRODUCT_SERVICE_URI=http://product-service:5001
CART_SERVICE_URI=http://shopping-cart-service:5002
ORDER_SERVICE_URI=http://order-service:5003
PAYMENT_SERVICE_URI=http://payment-service:5004
NOTIFICATION_SERVICE_URI=http://notification-service:5005

# ==================== PAYMENT GATEWAY ====================

# Stripe - Obtener de https://dashboard.stripe.com/apikeys
# Usar claves "Restricted API keys" en producción
STRIPE_SECRET_KEY=sk_live_YOUR_REAL_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_REAL_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Platform commission (%)
PLATFORM_COMMISSION=50

# ==================== EMAIL SERVICE ====================

# Gmail SMTP (o tu proveedor de email)
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_SECURE=false
NODEMAILER_EMAIL=your-email@gmail.com

# IMPORTANTE: Para Gmail, usar "App Password" NO contraseña de cuenta
# Generar en: https://myaccount.google.com/apppasswords
NODEMAILER_PASSWORD=your-app-password-from-gmail

# Email templates
SENDER_EMAIL=noreply@giveshare.com
SENDER_NAME=Give Share Gain

# ==================== SMS SERVICE (OPCIONAL) ====================

# Twilio - Obtener de https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== CORS & SECURITY ====================

# Frontend URLs
API_URL=https://giveshare.com
FRONTEND_URL=https://giveshare.com

# CORS Origins
CORS_ORIGIN=https://giveshare.com

# Para desarrollo local
CORS_ORIGIN_DEV=http://localhost:8080,http://localhost:3000

# ==================== LOGGING ====================

LOG_LEVEL=info
LOG_FORMAT=json

# ==================== MONITORING (OPCIONAL) ====================

# Sentry (Error tracking) - Opcional
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# DataDog (APM) - Opcional
DATADOG_API_KEY=your_datadog_api_key
DATADOG_SITE=datadoghq.com

# ==================== CACHE ====================

# Redis (para sesiones/caché) - Opcional
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ==================== FILE STORAGE ====================

# AWS S3 (para imágenes/archivos) - Opcional
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=giveshare-production

# ==================== FEATURE FLAGS ====================

# Enable/disable features
ENABLE_PAYMENTS=true
ENABLE_NOTIFICATIONS=true
ENABLE_SHIPPING_CALCULATOR=true
ENABLE_REVIEWS=true

# ==================== TIMEOUT SETTINGS ====================

# Milliseconds
REQUEST_TIMEOUT=30000
DATABASE_TIMEOUT=10000
EXTERNAL_API_TIMEOUT=15000

# ==================== RATE LIMITING ====================

# Requests per minute
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==================== SHIPPING ====================

# Colombian shipping settings
SHIPPING_BASE_URL=https://api.correos.com.co
SHIPPING_API_KEY=your_shipping_api_key

# Hardcoded commission on shipping (%)
SHIPPING_COMMISSION=50

# ==================== TESTING (Para CI/CD) ====================

# Test database (separate from production)
TEST_MONGO_URI=mongodb+srv://admin:PASSWORD@production.m7kj3.mongodb.net/test?retryWrites=true&w=majority

# ==================== SECRET KEYS (REGENERAR PARA PRODUCCIÓN) ====================

# Encryption keys
ENCRYPTION_KEY=your_encryption_key_32_chars_min
ENCRYPTION_IV=your_encryption_iv_16_chars

# Anti-CSRF tokens
CSRF_TOKEN_SECRET=your_csrf_secret_key

# ==================== NOTAS IMPORTANTES ====================

# 1. NUNCA commitear archivos .env a Git
#    Usar .env.production.local o variables en plataforma hosting
#
# 2. Secretos deben ser REGENERADOS para producción:
#    - JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - Obtener REAL Stripe keys (no test keys)
#    - Usar Gmail App Password (no contraseña de cuenta)
#
# 3. En Railway.app:
#    - Ir a Project → Environment
#    - Agregar cada variable como "Private Variable"
#    - Railway muestra solo últimos 4 caracteres por seguridad
#
# 4. En producción, usar:
#    - HTTPS siempre
#    - TLS 1.2+
#    - Certificados Let's Encrypt (Railway lo hace automáticamente)
#
# 5. Backup de Base de Datos:
#    - MongoDB Atlas: Backups automáticos cada 6 horas
#    - Configurar en MongoDB → Backup
#
# 6. Monitoreo:
#    - Railway: Dashboards automáticos de usage
#    - Logs: Ver en Railway Console
#    - Alertas: Configurar en Project → Alerts

# ==================== PLANTILLAS PARA COPIAR ====================

# Para Gmail en Railway:
# NODE_ENV: production
# NODEMAILER_EMAIL: tu-email@gmail.com
# NODEMAILER_PASSWORD: (app password de Gmail, NO contraseña de cuenta)
# NODEMAILER_HOST: smtp.gmail.com
# NODEMAILER_PORT: 587

# Para MongoDB Atlas:
# MONGO_URI_USERS: mongodb+srv://admin:PASSWORD@cluster.mongodb.net/users?retryWrites=true&w=majority
# (Reemplazar PASSWORD, cluster name, etc)

# Para Stripe:
# STRIPE_SECRET_KEY: sk_live_51234...
# STRIPE_PUBLISHABLE_KEY: pk_live_51234...
# (Obtener de dashboard.stripe.com)

# ==================== COMPROBAR EN PRODUCTION ====================

# Ejecutar estos comandos para verificar setup:
#
# 1. Test MongoDB connection:
#    curl -X GET http://localhost:5000/api/users/health
#
# 2. Test Stripe integration:
#    curl -X POST http://localhost:5004/api/payments/test \
#      -H "Content-Type: application/json"
#
# 3. Test Email:
#    curl -X POST http://localhost:5005/api/notification/send-email \
#      -H "Content-Type: application/json" \
#      -d '{
#        "to":"test@example.com",
#        "subject":"Test Email",
#        "text":"Testing email service"
#      }'
